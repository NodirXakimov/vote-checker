VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Which initiative's votes this deployment shows (votes.initiative_id, text).
# Required — without it the page would list every initiative's votes.
VITE_INITIATIVE_ID=your-initiative-id

# Shown in the page header. Optional; falls back to the district subtitle.
VITE_INITIATIVE_NAME=Нишон тумани, Гулистон МФЙ
